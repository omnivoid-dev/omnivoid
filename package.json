{
  "name": "omnivoid",
  "version": "0.4.0",
  "description": "A mobile-first, interactive visual experience with audio reactivity. Immersive audio-visual web application with particle systems and 3D graphics. Now with dynamic content management!",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 8080",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start -p 8080",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:seed": "npx tsx scripts/seed-admin.ts",
    "db:migrate:content": "npx tsx scripts/migrate-content.ts",
    "seed:admin": "npx tsx scripts/seed-admin.ts",
    "migrate:content": "npx tsx scripts/migrate-content.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omnivoid-dev/omnivoid.git"
  },
  "author": {
    "name": "OMNIVOID",
    "url": "https://github.com/omnivoid-dev"
  },
  "license": "MIT",
  "keywords": [
    "audio-visualization",
    "particle-system",
    "3d-graphics",
    "web-audio-api",
    "interactive",
    "mobile-first",
    "omnivoid"
  ],
  "homepage": "https://github.com/omnivoid-dev/omnivoid#readme",
  "bugs": {
    "url": "https://github.com/omnivoid-dev/omnivoid/issues"
  },
  "engines": {
    "node": "22.x"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^12.38.0",
    "next": "^14.2.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0"
  }
}
