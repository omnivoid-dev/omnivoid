// ============================================
// OMNIVOID LABS - Prisma Schema
// ============================================
// Database: Neon PostgreSQL
// ORM: Prisma 5.x
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================
// EDITIONS - Concert series editions
// ============================================
model Edition {
  id                  String    @id @default(cuid())
  name                String    // "OMNIVOID 010"
  slug                String    @unique // "010"
  description         String?
  eventDate           DateTime? // Single event day
  venue               String?
  city                String?

  // Ritual slot
  posterUrl           String?   // Main edition poster
  isLatestRitual      Boolean   @default(false) // The upcoming edition. Only one at a time.
  ticketUrl           String?   // Only kept while isLatestRitual (cleared by the API otherwise)
  ticketLabel         String?   // "GET TICKETS" / "SOLD OUT"

  // Workshop slot
  hasWorkshop         Boolean   @default(false)
  workshopTitle       String?
  workshopDescription String?
  workshopDateTime    DateTime?
  workshopPosterUrl   String?
  workshopTicketUrl   String?   // Only kept while isLatestRitual

  themeColors         Json?     // { primary: "#99ccff", secondary: "#336699" } - per-edition site theme
  isActive            Boolean   @default(true)
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  performers     Performer[]
  transmissions  Transmission[]
  resources      Resource[]
  radioShows     RadioShow[]
  links          Link[]
  documents      Document[]

  @@index([slug])
  @@index([isActive])
  @@index([isLatestRitual])
}

// ============================================
// PERFORMERS - Artists on an edition's roster
// ============================================
model Performer {
  id        String   @id @default(cuid())
  editionId String
  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)

  name      String
  instagram String?
  youtube   String?  // Channel handle or URL
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transmissions Transmission[]
  resources     Resource[]
  radioShows    RadioShow[]

  @@index([editionId])
  @@index([name])
}

// ============================================
// TRANSMISSIONS - YouTube videos belonging to an edition (optionally to a performer)
// ============================================
model Transmission {
  id           String           @id @default(cuid())
  editionId    String
  edition      Edition          @relation(fields: [editionId], references: [id], onDelete: Cascade)
  performerId  String?
  performer    Performer?       @relation(fields: [performerId], references: [id], onDelete: SetNull)

  title        String           // Display name shown on the site (editable)
  originalTitle String?         // Title as it appears on YouTube
  url          String
  youtubeId    String?
  thumbnailUrl String?
  kind         TransmissionKind @default(SET)
  isActive     Boolean          @default(true)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([editionId])
  @@index([performerId])
  @@index([kind])
}

enum TransmissionKind {
  SET       // Live performance
  WORKSHOP
  LABS
  OTHER
}

// ============================================
// RESOURCES - Content items for editions
// ============================================
model Resource {
  id          String   @id @default(cuid())
  editionId   String
  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  performerId String?
  performer   Performer? @relation(fields: [performerId], references: [id], onDelete: SetNull)
  
  type        ResourceType // AUDIO, VIDEO, POSTER, DOCUMENT, LINK, GALLERY
  title       String
  description String?
  
  // For Google Drive or external links
  url         String?  // YouTube URL, Google Drive URL, etc.
  
  // For local files (relative path)
  filePath    String?  // "public/audio/track.mp3"
  
  // Thumbnail preview
  thumbnailUrl String? // Google Drive image URL
  
  // Type-specific metadata
  metadata    Json?    // { duration, artist, youtubeId, mixcloudId, etc. }
  
  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([editionId])
  @@index([performerId])
  @@index([type])
  @@index([isActive])
}

enum ResourceType {
  AUDIO        // Music files, Mixcloud playlists
  VIDEO        // YouTube videos
  POSTER       // Event posters/flyers
  DOCUMENT     // PDFs, research papers
  LINK         // External links
  GALLERY      // Images
  LOGO         // Edition logos
  TEXT_CONTENT // Text content (replaces .txt files)
}

// ============================================
// LINKS - External links (Mixcloud, YouTube)
// ============================================
model Link {
  id          String   @id @default(cuid())
  editionId   String?
  edition     Edition? @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  
  // Link type
  type        LinkType // MIXCLOUD, YOUTUBE, WEBSITE, SOCIAL
  url         String   // The actual URL
  
  // Metadata based on type
  metadata    Json?    // { showId, duration, thumbnail, platform }
  
  // Categorization
  category    String?  // "live_transmissions", "conundrum", "contact", "labs"
  
  // Display
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([editionId])
  @@index([type])
  @@index([category])
  @@index([isActive])
}

enum LinkType {
  MIXCLOUD   // Mixcloud shows
  YOUTUBE    // YouTube videos/channels
  WEBSITE    // External websites
  SOCIAL     // Social media links
  PODCAST    // Podcast links
  OTHER      // Other links
}

// ============================================
// RADIO SHOWS - Mixcloud shows for the RADIO window (not tied to an edition)
// ============================================
model RadioShow {
  id            String     @id @default(cuid())
  title         String     // Display name shown on the site (editable)
  originalTitle String?    // Title as it appears on Mixcloud
  url           String     // Full Mixcloud show URL
  thumbnailUrl  String?
  author        String?    // Mixcloud account name
  editionId     String?
  edition       Edition?   @relation(fields: [editionId], references: [id], onDelete: SetNull)
  performerId   String?
  performer     Performer? @relation(fields: [performerId], references: [id], onDelete: SetNull)
  isActive      Boolean    @default(true)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([editionId])
  @@index([performerId])
  @@index([isActive])
}

// ============================================
// DOCUMENTS - Text content (replaces .txt files)
// ============================================
model Document {
  id          String   @id @default(cuid())
  editionId   String?
  edition     Edition? @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  title       String
  slug        String?  @unique // URL-friendly identifier
  
  // Content type
  type        DocumentType // RESEARCH, CONUNDRUM, CONTACT, LABS, TRANSMISSIONS
  
  // Content
  content     String   // Rich text content (HTML or Markdown)
  excerpt     String?  // Short description
  
  // File attachment (for PDFs, etc.)
  fileUrl     String?  // URL to attached file
  fileName    String?
  thumbnailUrl String? // Cover image (WebP, optimised on upload)
  
  // Display
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([editionId])
  @@index([type])
  @@index([isActive])
}

enum DocumentType {
  RESEARCH       // Research papers
  CONUNDRUM      // Conundrum text
  CONTACT        // Contact information
  LABS           // Labs information
  TRANSMISSIONS  // Live transmissions text
  CUSTOM         // Custom content type
}

// ============================================
// SITE SETTINGS - Global configuration
// ============================================
model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique // "currentEdition", "siteTitle", etc.
  value     Json     // Flexible value storage
  updatedAt DateTime @updatedAt
}