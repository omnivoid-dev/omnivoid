// ============================================
// OMNIVOID LABS - Prisma Schema
// ============================================
// Database: Neon PostgreSQL
// ORM: Prisma 5.x
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================
// EDITIONS - Concert series editions
// ============================================
model Edition {
  id                String   @id @default(cuid())
  name              String   // "OMNIVOID 010"
  slug              String   @unique // "010"
  description       String?  // Edition description
  posterUrl         String?  // Main edition poster URL
  workshopPosterUrl String?  // Workshop poster URL
  eventDate         DateTime? // Single event date
  artists           Json?    // Array of { name, instagram, youtube }
  youtubeLinks      Json?    // Array of { title, url }
  isLatestRitual    Boolean  @default(false) // Set as Latest Ritual
  themeColors       Json?    // { primary: "#99ccff", secondary: "#336699" }
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  resources   Resource[]
  gigs        Gig[]
  links       Link[]
  documents   Document[]
  
  @@index([slug])
  @@index([isActive])
}

// ============================================
// RESOURCES - Content items for editions
// ============================================
model Resource {
  id          String   @id @default(cuid())
  editionId   String
  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  type        ResourceType // AUDIO, VIDEO, POSTER, DOCUMENT, LINK, GALLERY
  title       String
  description String?
  
  // For Google Drive or external links
  url         String?  // YouTube URL, Google Drive URL, etc.
  
  // For local files (relative path)
  filePath    String?  // "public/audio/track.mp3"
  
  // Thumbnail preview
  thumbnailUrl String? // Google Drive image URL
  
  // Type-specific metadata
  metadata    Json?    // { duration, artist, youtubeId, mixcloudId, etc. }
  
  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([editionId])
  @@index([type])
  @@index([isActive])
}

enum ResourceType {
  AUDIO        // Music files, Mixcloud playlists
  VIDEO        // YouTube videos
  POSTER       // Event posters/flyers
  DOCUMENT     // PDFs, research papers
  LINK         // External links
  GALLERY      // Images
  LOGO         // Edition logos
  TEXT_CONTENT // Text content (replaces .txt files)
}

// ============================================
// GIGS - Concert/event entries (Latest Rituals)
// ============================================
model Gig {
  id          String   @id @default(cuid())
  editionId   String?
  edition     Edition? @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  title       String   // Gig title
  subtitle    String?  // Optional subtitle
  description String?  // Full description
  
  // Event details
  date        DateTime // Event date/time
  venue       String?  // Venue name
  location    String?  // City/address
  address     String?  // Full address
  
  // Workshop tab content
  hasWorkshop Boolean  @default(false)
  workshopTitle    String?
  workshopDescription String?
  workshopMaterials   String? // JSON array of materials needed
  workshopTime    DateTime?
  
  // Media
  images      String[] // Array of image URLs
  videoUrl    String?  // YouTube or other video
  mixcloudUrl String?  // Mixcloud show URL
  
  // Status
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  isPast      Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([editionId])
  @@index([date])
  @@index([isActive])
  @@index([isFeatured])
}

// ============================================
// LINKS - External links (Mixcloud, YouTube)
// ============================================
model Link {
  id          String   @id @default(cuid())
  editionId   String?
  edition     Edition? @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  
  // Link type
  type        LinkType // MIXCLOUD, YOUTUBE, WEBSITE, SOCIAL
  url         String   // The actual URL
  
  // Metadata based on type
  metadata    Json?    // { showId, duration, thumbnail, platform }
  
  // Categorization
  category    String?  // "live_transmissions", "conundrum", "contact", "labs"
  
  // Display
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([editionId])
  @@index([type])
  @@index([category])
  @@index([isActive])
}

enum LinkType {
  MIXCLOUD   // Mixcloud shows
  YOUTUBE    // YouTube videos/channels
  WEBSITE    // External websites
  SOCIAL     // Social media links
  PODCAST    // Podcast links
  OTHER      // Other links
}

// ============================================
// DOCUMENTS - Text content (replaces .txt files)
// ============================================
model Document {
  id          String   @id @default(cuid())
  editionId   String?
  edition     Edition? @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  title       String
  slug        String?  @unique // URL-friendly identifier
  
  // Content type
  type        DocumentType // RESEARCH, CONUNDRUM, CONTACT, LABS, TRANSMISSIONS
  
  // Content
  content     String   // Rich text content (HTML or Markdown)
  excerpt     String?  // Short description
  
  // File attachment (for PDFs, etc.)
  fileUrl     String?  // URL to attached file
  fileName    String?
  
  // Display
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([editionId])
  @@index([type])
  @@index([isActive])
}

enum DocumentType {
  RESEARCH       // Research papers
  CONUNDRUM      // Conundrum text
  CONTACT        // Contact information
  LABS           // Labs information
  TRANSMISSIONS  // Live transmissions text
  CUSTOM         // Custom content type
}

// ============================================
// SITE SETTINGS - Global configuration
// ============================================
model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique // "currentEdition", "siteTitle", etc.
  value     Json     // Flexible value storage
  updatedAt DateTime @updatedAt
}